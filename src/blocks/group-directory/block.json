{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gatherpress/group-directory",
	"version": "1.0.0",
	"title": "Group Directory",
	"category": "gatherpress",
	"icon": "groups",
	"example": {},
	"description": "Displays a searchable directory of all community groups in the network.",
	"attributes": {
		"perPage": {
			"type": "number",
			"default": 12
		},
		"showSearch": {
			"type": "boolean",
			"default": true
		},
		"columns": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false
	},
	"textdomain": "gatherpress",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"style": "file:./style-index.css"
}
